# Copy to .env before starting: cp .env.example .env
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_dev_password
POSTGRES_DB=todo
POSTGRES_PORT=5432

# Host-run backend (go run). The backend container overrides this with db:5432.
DATABASE_URL=postgres://todo:todo_dev_password@localhost:5432/todo?sslmode=disable

# Backend (used from Task 2 onwards)
HTTP_ADDR=:8080
APP_ENV=development
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_TTL=30m
COOKIE_SECURE=false

# Frontend container (used from Task 10)
FRONTEND_PORT=3000
